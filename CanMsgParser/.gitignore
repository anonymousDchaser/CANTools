__pycache__/
*.pyc
*.pyo
.pytest_cache/

# PyInstaller 打包产物（全部不入库，二进制经 GitHub Release 下发）
# 说明：dist/ 曾有 1200+ 个二进制文件随版本提交，导致 .git 体积膨胀到 500MB+，
#       现改为仅由 Release 附件下发；build/ 与 *.spec 为可重建中间产物。
build/
dist/
*.spec

# 安装包产物（Inno Setup 编译输出）：同样改由 GitHub Release 下发，不入库
installer/output/

# 构建临时垃圾目录（build.py 把上一版 dist/build 改名移到此处，不入库）
.build_trash/

# 构建日志与临时备份
*.log
_diag.log
build_log.txt
build_err.txt
*.bak_*
build.bak_*
dist.bak_*
build_bak*/
dist_bak*/
oldversion*/
WB101.json

# 工作记忆目录（本地状态，不入库）
.workbuddy/

# 调试脚本（临时排查用，不应入库）
tests/_dbg.py

# macOS（Finder 元数据，Windows 侧不会产生）
.DS_Store
.AppleDouble
._*

# 虚拟环境（macOS 用户按 README 在 .venv 中安装依赖）
.venv/
venv/
